---
import Caminho from './Caminho.astro';
import { ARQUIVOS, urlDe, type Lang } from '../i18n';
import { GRUPOS } from '../data/perfil';
import { projetosDe } from '../lib/projetos';
interface Props { lang: Lang }
const { lang } = Astro.props;
const lista = await projetosDe(lang);
const ordem = ['seteg', 'proprio', 'antes', 'pesquisa'] as const;
const grupos = ordem.map((g) => ({ g, ...GRUPOS[lang][g], itens: lista.filter((p) => p.data.grupo === g) })).filter((x) => x.itens.length);
const t = lang === 'pt'
  ? { h: 'Projetos', p: 'O que construí, com o problema que cada coisa resolve e o meu papel nela.' }
  : { h: 'Projects', p: 'What I built, the problem each piece solves and my role in it.' };
---
<Caminho lang={lang} arquivo={ARQUIVOS[lang].projetos} />
<h1 class="title">{t.h}</h1>
<p class="lede">{t.p}</p>
{grupos.map((gr) => (
  <section class="grupo wide">
    <h2 class="sec">{gr.titulo}</h2>
    {gr.nota && <p class="nota">{gr.nota}</p>}
    <ul class="plist">
      {gr.itens.map((p) => (
        <li>
          <a href={urlDe(p.slug, lang)} data-view={p.slug}>
            <span class="meta"><span class="t">{p.data.nome}</span><span class="kind">{p.data.tipo}</span></span>
            <span class="meta"><span class="s">{p.data.resumo}</span><span class="file">{ARQUIVOS[lang].dir}/{p.slug}.md</span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>
))}
