---
import Caminho from './Caminho.astro';
import { ARQUIVOS, type Lang } from '../i18n';
import { LINKS, PESQUISA } from '../data/perfil';
import { CV, autores, md, tr } from '../lib/cv';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = PESQUISA[lang];
// Só os últimos três anos (o ano corrente e os dois anteriores); o resto fica no Lattes.
const ate = new Date().getFullYear();
const desde = ate - 2;
const recente = (i: any) => parseInt(String(i.ano), 10) >= desde;
const publicacoes = CV.publicacoes.filter(recente);
const listas = ([
  [t.tecnica, CV.producao_tecnica],
  [t.coorientacoes, CV.coorientacoes],
  [t.bancas, CV.bancas],
  [t.ensino, CV.ensino],
] as const).map(([titulo, itens]) => [titulo, itens.filter(recente)] as const).filter(([, itens]) => itens.length > 0);
---
<Caminho lang={lang} arquivo={ARQUIVOS[lang].pesquisa} />
<h1 class="title">{t.titulo}</h1>
{t.texto.map((p, i) => <p class={i === 0 ? 'lede' : ''}>{p}</p>)}

<h2 class="sec">{t.publicacoes} ({desde}–{ate})</h2>
<ol class="papers">
  {publicacoes.map((p: any) => (
    <li>
      <span class="y">{p.ano}{p.status && ` · ${tr(p.status, lang)}`}</span>{' '}
      <span set:html={md(p.titulo)} />.{' '}
      <em>{p.revista}</em>{p.detalhes && ` ${p.detalhes}`}.
      <span class="aut" set:html={autores(p.autores)} />
      {p.doi && <a class="doi" href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener">doi:{p.doi}</a>}
    </li>
  ))}
</ol>
<p style="margin-top:1.4em"><a href={LINKS.lattes} target="_blank" rel="noopener">{t.completa} ↗</a></p>

{listas.map(([titulo, itens]) => (
  <>
    <h2 class="sec">{titulo} ({desde}–{ate})</h2>
    <ul class="itens">
      {itens.map((i: any) => <li><span class="r">{i.ano}{i.nivel && ` · ${i.nivel}`}</span> <span set:html={md(i.texto)} /></li>)}
    </ul>
  </>
))}
